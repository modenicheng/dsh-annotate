{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "packages/**",
      "scripts/**",
      "!**/.agents",
      "!packages/plugin/src/protocol.js",
      "!packages/extension/src/shared/protocol.js",
      "!packages/extension/src/shared/protocol.global.js",
      "!packages/extension/manifest.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 120,
    "lineEnding": "lf"
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "jsxQuoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },
  "json": {
    "formatter": {
      "enabled": true
    }
  },
  "assist": {
    "enabled": false
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "complexity": {
        "useOptionalChain": "off"
      },
      "correctness": {
        "noUnusedVariables": "on"
      },
      "style": {
        "useConst": "on"
      },
      "suspicious": {
        "noDoubleEquals": "on",
        "noExplicitAny": "off",
        "noAssignInExpressions": "off"
      }
    }
  }
}
