#!/bin/sh
# Enforce Conventional Commits on the subject line.
#
# Git runs this for every commit, including merges. Use `git commit --no-verify`
# deliberately if a merge or revert subject cannot be expressed in this format.
# Portable POSIX sh: works in Git Bash on Windows as well as on macOS/Linux.

message_file=$1

if [ -z "$message_file" ] || [ ! -f "$message_file" ]; then
  echo "commit-msg: cannot read the commit message file" >&2
  exit 1
fi

subject=$(sed -n '1p' "$message_file" | tr -d '\r')
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert)(\([a-z0-9/.-]+\))?!?: .{1,72}$'

if printf '%s\n' "$subject" | grep -Eq "$pattern"; then
  exit 0
fi

cat >&2 <<'EOF'
commit-msg: the commit subject does not follow Conventional Commits.

  format:   <type>(<scope>)!: <description>
  types:    feat fix docs style refactor perf test build ci chore revert
  scope:    optional, lowercase letters, digits, '/', '.', '-'
  limit:    72 characters after ": " (keep the whole subject near 72)
  "!" and "(scope)" are optional.

Examples:
  feat(extension): capture region screenshots
  fix(plugin): close sockets during shutdown
  docs: explain the bridge token file
  chore!: drop protocol version 1

Edit the message with:  git commit --amend
Bypass once with:       git commit --no-verify
EOF

printf '  got:      %s\n' "$subject" >&2
exit 1
