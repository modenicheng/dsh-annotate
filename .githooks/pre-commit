#!/bin/sh
# Fast local gate: generated files, syntax, and format/lint — all sub-second.
# The unit tests are NOT here: they cost seconds per commit and already run in
# CI (.github/workflows/ci.yml) and in the release workflow. Keep this hook to
# checks whose feedback is faster than a human can context-switch.
#
# Runs before every commit from the repository root. Skips cleanly when Node is
# not installed so a commit from a machine without the toolchain still works.
# Bypass deliberately with `git commit --no-verify`.

set -u

if ! command -v node >/dev/null 2>&1; then
  echo "pre-commit: node not found on PATH; skipping checks"
  exit 0
fi

root=$(git rev-parse --show-toplevel 2>/dev/null) || {
  echo "pre-commit: not inside a git work tree; skipping checks" >&2
  exit 0
}
cd "$root" || {
  echo "pre-commit: cannot enter $root" >&2
  exit 1
}

echo "pre-commit: checking generated protocol copies"
node scripts/check-sync.mjs || {
  echo "pre-commit: fix with 'pnpm run sync-protocol' and re-stage the files." >&2
  exit 1
}

echo "pre-commit: checking JavaScript syntax"
node scripts/check-syntax.mjs || {
  echo "pre-commit: fix the syntax errors above before committing." >&2
  exit 1
}

echo "pre-commit: Biome format and lint (same pinned version as CI)"
# The workspace devDependency, resolved through the local bin link — no
# network, no npx resolution cost. Falls back to the pinned npx call only
# when dependencies were never installed on this machine.
biome="$root/node_modules/.bin/biome"
if [ -x "$biome" ]; then
  if ! "$biome" check .; then
    echo "pre-commit: Biome failed. Run 'pnpm biome check --write .' and re-stage." >&2
    exit 1
  fi
else
  echo "pre-commit: node_modules/.bin/biome missing; falling back to npx (run 'pnpm install')"
  if ! npx --yes @biomejs/biome@2.4.14 check .; then
    echo "pre-commit: Biome failed. Install deps ('pnpm install'), then run 'pnpm biome check --write .'" >&2
    exit 1
  fi
fi

echo "pre-commit: all checks passed (unit tests run in CI, not here)"
