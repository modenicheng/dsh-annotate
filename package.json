{
  "name": "dsh-marker-workspace",
  "version": "0.1.5",
  "private": true,
  "type": "module",
  "description": "Visual annotation and context bridge between a daily browser (Firefox/Zen) and DeepSeek Harness",
  "scripts": {
    "test": "node --test \"packages/*/test/*.test.js\"",
    "fmt": "biome format --write .",
    "fmt:check": "biome format .",
    "lint": "biome lint .",
    "check": "npm run fmt:check && npm run lint && node scripts/check-sync.mjs && node scripts/check-syntax.mjs && node scripts/build-icons.mjs --check && npm run test",
    "check:syntax": "node scripts/check-syntax.mjs",
    "check:sync": "node scripts/check-sync.mjs",
    "check:manifest": "node scripts/check-manifest.mjs",
    "check:icons": "node scripts/build-icons.mjs --check",
    "icons": "node scripts/build-icons.mjs",
    "build:extension": "node scripts/build-extension.mjs",
    "sync-protocol": "node scripts/sync-protocol.mjs",
    "hooks:install": "git config core.hooksPath .githooks"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14"
  }
}
