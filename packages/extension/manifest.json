{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.1.4",
  "description": "__MSG_extDescription__",
  "default_locale": "en",
  "homepage_url": "https://github.com/modenicheng/dsh-annotate",
  "browser_specific_settings": {
    "gecko": {
      "id": "dsh-marker@modenc.top",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "icons": {
    "16": "icon/icon-16.png",
    "32": "icon/icon-32.png",
    "48": "icon/icon-48.png",
    "96": "icon/icon-96.png",
    "128": "icon/icon-128.png"
  },
  "permissions": ["storage", "alarms", "tabs", "activeTab", "scripting"],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  },
  "host_permissions": [
    "http://127.0.0.1/*",
    "http://localhost/*",
    "https://127.0.0.1/*",
    "https://localhost/*",
    "ws://127.0.0.1/*",
    "ws://localhost/*",
    "wss://127.0.0.1/*",
    "wss://localhost/*"
  ],
  "background": {
    "scripts": [
      "src/shared/platform.js",
      "src/shared/protocol.global.js",
      "src/shared/inject.js",
      "src/background/endpoints.js",
      "src/background/discovery.js",
      "src/background/connection.js",
      "src/background/core.js",
      "src/background/socket.js",
      "src/background/outbox.js",
      "src/background/capture.js",
      "src/background/routing.js",
      "src/background/main.js"
    ]
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/shared/platform.js",
        "src/shared/protocol.global.js",
        "src/content/anchor.js",
        "src/content/hydrator.js",
        "src/shared/shortcut.js",
        "src/content/ui/strings.js",
        "src/content/ui/styles.js",
        "src/content/ui/dom.js",
        "src/content/ui/overlay.js",
        "src/content/ui/hud.js",
        "src/content/ui/target.js",
        "src/content/ui/composer.js",
        "src/content/ui/badges.js",
        "src/content/ui/index.js",
        "src/content/main.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["src/content/console-hook.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icon/icon-16.png",
      "32": "icon/icon-32.png"
    }
  },
  "commands": {
    "annotate-page": {
      "suggested_key": {
        "default": "Alt+Shift+A"
      },
      "description": "Annotate the current page"
    }
  }
}
