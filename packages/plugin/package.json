{
  "name": "dsh-marker",
  "version": "1.0.1",
  "description": "Visual annotation bridge: mark text, elements, or regions in Firefox/Zen and hand them to DeepSeek Harness as first-class context",
  "type": "module",
  "license": "MIT",
  "main": "./index.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/modenicheng/dsh-annotate.git",
    "directory": "packages/plugin"
  },
  "homepage": "https://github.com/modenicheng/dsh-annotate#readme",
  "bugs": {
    "url": "https://github.com/modenicheng/dsh-annotate/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "src",
    "cordis.patch.yml",
    "locale/*.json",
    "docs",
    "icon.svg"
  ],
  "dependencies": {
    "ws": "^8.18.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  },
  "engines": {
    "node": ">=22",
    "dsh": ">=0.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "annotation",
    "marker",
    "browser",
    "firefox",
    "zen",
    "deepseek-harness"
  ]
}
